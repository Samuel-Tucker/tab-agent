{
  "manifest_version": 3,
  "name": "Tab-Agent — Sticky CLI Sidebar",
  "short_name": "Tab-Agent",
  "version": "0.2.0",
  "description": "Sticky per-tab AGY & Claude Code chat sidebar with passive URL-to-repo linking, opt-in DevTools inspection, and SQLite history recovery.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "scripting",
    "debugger",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:7752/*",
    "http://localhost:7752/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Tab-Agent Sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
